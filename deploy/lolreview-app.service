[Unit]
Description=LeagueVODreview review app (API on 127.0.0.1:8000, served over HTTPS by Caddy)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/python -m lolreview.app --port 8000
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
