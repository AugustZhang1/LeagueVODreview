[Unit]
Description=LeagueVODreview crawler and progress page
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@REPO@
ExecStart=@REPO@/.venv/bin/python -m lolreview.crawler
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
# Longer than the crawler's JOIN_TIMEOUT_S, so a stop saves every thread's games.
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
